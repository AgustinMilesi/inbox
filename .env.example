# ==============================================================================
# Neon PostgreSQL Connection Strings
# ==============================================================================
# DATABASE_URL: Pooled connection string (with '-pooler' in the host).
# Used by the Next.js runtime and serverless functions via PgBouncer.
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/saas?sslmode=require"

# DIRECT_URL: Direct unpooled connection string (without '-pooler').
# Used exclusively by Prisma CLI for schema migrations (prisma migrate deploy/dev).
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/saas?sslmode=require"

# ==============================================================================
# Application Configuration
# ==============================================================================
# Public address of the app (no trailing slash)
APP_URL="http://localhost:3000"

# Time zone used to format dates in dashboard & messages
APP_TIMEZONE="America/Argentina/Buenos_Aires"

# ==============================================================================
# Email Service (Resend)
# ==============================================================================
# Optional in development (emails will be logged to server console if omitted)
RESEND_API_KEY=""
EMAIL_FROM="SaaS Inbox <onboarding@resend.dev>"
